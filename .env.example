# ─── Production-only setup ───────────────────────────────────
# Satu environment untuk local dev & Vercel (keduanya pakai Convex prod)

# Convex production deployment
CONVEX_DEPLOYMENT=prod:your-deployment-name
CONVEX_DEPLOY_KEY=prod:your-deployment-name|<deploy-key-from-dashboard>
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# Google OAuth — satu Client ID untuk semua
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
